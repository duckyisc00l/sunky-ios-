// object oRotate sprite -1 parent -100 depth 0 persistent false
// ===== event type 0 num 0
r = 0;

// ===== event type 5 num 39
// Rotate and update the camera angle.
r -= 5;
view_angle[0] = r;

// ===== event type 5 num 37
// Rotate and update the camera angle.
r += 5;
view_angle[0] = r;

